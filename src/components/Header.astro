---
import Icon from './Icon.astro';
import { site, path, localePath, type Locale } from '../config/site';
import type { Content } from '../content/types';
interface Props { content: Content; locale: Locale }
const { content: c, locale } = Astro.props;
const archived = Astro.url.pathname.startsWith(path('old/'));
const pagePath = (language: Locale) => localePath(language, archived);
const ids = ['about', 'technical', 'pricing', 'faq'];
---
<header class="header">
  <div class="container header-inner">
    <a class="wordmark" href={pagePath(locale)} aria-label={site.name}><span class="brand-lockup"><img class="brand-logo" src={path('images/lan-ict-logo.png')} width="573" height="533" alt="" /><span class="brand-type"><span>LAN-ICT</span><small>OFFSITE DATA BACKUP</small></span></span></a>
    <button class="menu-toggle" hidden aria-expanded="false" aria-controls="main-nav" data-open={c.menu} data-close={c.close}>{c.menu}<span aria-hidden="true">☰</span></button>
    <nav id="main-nav" aria-label={c.navLabel}>
      <div class="nav-links">{ids.map((id, i) => <a href={`#${id}`}>{c.nav[i]}</a>)}</div>
      <div class="header-actions">
        <div class="languages"><a href={pagePath('sr')} lang="sr-Latn" aria-label="Srpski" aria-current={locale === 'sr' ? 'page' : undefined}>SR</a><span aria-hidden="true">/</span><a href={pagePath('en')} lang="en" aria-label="English" aria-current={locale === 'en' ? 'page' : undefined}>EN</a></div>
        <a class="button button-small" href="#contact">{c.quote}<Icon name="arrow" size={17} /></a>
      </div>
    </nav>
  </div>
</header>
<dialog class="mobile-drawer" aria-label={c.navLabel}>
  <div class="drawer-top"><span>{c.menu}</span><button class="drawer-close" aria-label={c.close}>{c.close}<span aria-hidden="true">×</span></button></div>
</dialog>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#main-nav');
  const header = document.querySelector<HTMLElement>('.header');
  const home = document.querySelector('.header-inner');
  const drawer = document.querySelector<HTMLDialogElement>('.mobile-drawer');
  const closeButton = document.querySelector<HTMLButtonElement>('.drawer-close');
  const mobile = matchMedia('(max-width: 767px)');
  if (toggle && nav && header && home && drawer && closeButton) {
    toggle.hidden = false;
    nav.classList.add('enhanced');
    const setExpanded = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.firstChild!.textContent = open ? toggle.dataset.close! : toggle.dataset.open!;
    };
    const closeDrawer = () => {
      if (drawer.open) drawer.close();
    };
    drawer.addEventListener('close', () => {
      document.documentElement.classList.remove('mobile-menu-open');
      setExpanded(false);
      header.classList.remove('header-hidden');
    });
    toggle.addEventListener('click', () => {
      if (mobile.matches) {
        header.classList.remove('header-hidden');
        drawer.showModal();
        document.documentElement.classList.add('mobile-menu-open');
        setExpanded(true);
      } else {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        nav.classList.toggle('is-open', open);
        setExpanded(open);
      }
    });
    closeButton.addEventListener('click', closeDrawer);
    drawer.addEventListener('keydown', event => {
      if (event.key !== 'Tab') return;
      const controls = [...drawer.querySelectorAll<HTMLElement>('button, a[href]')];
      const first = controls[0];
      const last = controls.at(-1);
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    });
    drawer.addEventListener('click', event => {
      const rect = drawer.getBoundingClientRect();
      if (event.target === drawer && (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom)) closeDrawer();
    });
    nav.querySelectorAll('a').forEach(link => link.addEventListener('click', () => {
      closeDrawer();
      nav.classList.remove('is-open');
      setExpanded(false);
    }));
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && !drawer.open && toggle.getAttribute('aria-expanded') === 'true') {
        nav.classList.remove('is-open');
        setExpanded(false);
        toggle.focus();
      }
    });
    let previousY = window.scrollY;
    let direction = 0;
    let distance = 0;
    const syncLayout = () => {
      closeDrawer();
      (mobile.matches ? drawer : home).append(nav);
      toggle.setAttribute('aria-controls', mobile.matches ? 'mobile-menu' : 'main-nav');
      if (mobile.matches) toggle.setAttribute('aria-haspopup', 'dialog');
      else toggle.removeAttribute('aria-haspopup');
      nav.classList.remove('is-open');
      setExpanded(false);
      header.classList.remove('header-hidden');
      previousY = window.scrollY;
      distance = 0;
      direction = 0;
    };
    drawer.id = 'mobile-menu';
    syncLayout();
    mobile.addEventListener('change', syncLayout);
    matchMedia('(min-width: 75rem)').addEventListener('change', () => {
      nav.classList.remove('is-open');
      setExpanded(false);
    });
    window.addEventListener('scroll', () => {
      const y = Math.max(0, window.scrollY);
      const delta = y - previousY;
      previousY = y;
      if (!mobile.matches || drawer.open) return;
      if (y <= 16) {
        header.classList.remove('header-hidden');
        distance = 0;
        direction = 0;
        return;
      }
      const nextDirection = Math.sign(delta);
      if (!nextDirection) return;
      distance = nextDirection === direction ? distance + Math.abs(delta) : Math.abs(delta);
      direction = nextDirection;
      if (distance >= 12) header.classList.toggle('header-hidden', direction > 0);
    }, { passive: true });
  }
</script>
<style>
  .header { background: var(--white); border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 20; }
  .header-inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; min-height: 100px; gap: 1rem; padding-block: 1rem; }
  .wordmark { display: inline-flex; align-items: center; gap: .8rem; color: var(--navy); font-size: clamp(1rem,2vw,1.7rem); font-weight: 750; text-decoration: none; white-space: nowrap; letter-spacing: -.04em; }
  .brand-lockup { display: inline-flex; align-items: center; gap: .6rem; }
  .brand-logo { display: block; width: 68px; height: auto; flex-shrink: 0; }
  .brand-type { display: flex; flex-direction: column; line-height: 1.15; letter-spacing: -.02em; }
  .brand-type small { font-size: .55em; font-weight: 500; margin-top: .25rem; letter-spacing: .03em; }
  nav { width: 100%; }
  .nav-links, .header-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem 1rem; }
  .nav-links a { font-size: .72rem; font-weight: 650; text-transform: uppercase; letter-spacing: .025em; text-decoration: none; padding-block: .8rem; }
  .nav-links a:hover { color: var(--blue-dark); }
  .languages { display: flex; align-items: center; gap: .4rem; font-size: .75rem; }
  .languages a { display: inline-flex; align-items: center; min-height: 44px; padding-inline: .25rem; text-decoration: none; color: var(--muted); }
  .languages a[aria-current] { font-weight: 750; color: var(--navy); text-decoration: underline; text-underline-offset: .3rem; }
  .menu-toggle { align-items: center; gap: .65rem; background: var(--white); border: 1px solid var(--border); border-radius: .4rem; padding: .7rem; color: var(--navy); font: inherit; font-size: .85rem; min-height: 44px; }
  .menu-toggle:not([hidden]) { display: inline-flex; }
  nav.enhanced { display: none; }
  .mobile-drawer { border: 0; padding: 1.25rem; color: var(--navy); background: var(--white); width: min(360px, calc(100% - 2rem)); max-width: none; height: 100dvh; max-height: none; margin: 0 0 0 auto; box-shadow: -12px 0 40px #072b6220; }
  .mobile-drawer::backdrop { background: #061b3c80; }
  .mobile-drawer[open] { animation: drawer-enter .22s ease-out; }
  .drawer-top { display: flex; align-items: center; justify-content: space-between; gap: .5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border); font-weight: 700; }
  .drawer-close { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; border: 0; background: transparent; color: var(--navy); font-size: .8rem; }
  .drawer-close span { font-size: 1.75rem; }
  .mobile-drawer nav.enhanced { display: block; }
  .mobile-drawer .nav-links { flex-direction: column; align-items: stretch; gap: 0; margin-block: 1rem; }
  .mobile-drawer .nav-links a { font-size: .9rem; text-transform: none; padding: 1rem .25rem; border-bottom: 1px solid var(--border); }
  .mobile-drawer .header-actions { flex-direction: column; align-items: stretch; gap: 1rem; }
  .mobile-drawer .languages { gap: .75rem; }
  @keyframes drawer-enter { from { transform: translateX(100%); } to { transform: translateX(0); } }
  @media (prefers-reduced-motion: reduce) { .mobile-drawer[open] { animation: none; } }
  @media (max-width: 767px) {
    .header { transition: transform .2s ease; }
    .header-hidden { transform: translateY(-100%); }
    .header-inner { min-height: 76px; padding-block: .65rem; gap: .5rem; }
    .brand-logo { width: 46px; }
    .brand-lockup { gap: .45rem; }
    .menu-toggle { padding: .5rem .65rem; }
    .header:has(.menu-toggle[hidden]) { position: relative; }
  }
  @media (max-width: 24rem) { .brand-logo { width: 48px; } .header-inner { gap: .5rem; } .wordmark { gap: .45rem; } }
  nav.enhanced.is-open { display: block; }
  @media (min-width: 48rem) {
    nav, nav.enhanced.is-open { display: flex; align-items: center; gap: 1rem; }
    .nav-links, .header-actions { flex-wrap: nowrap; }
    .nav-links a, .header-actions { white-space: nowrap; }
    .header-actions { margin-left: auto; }
  }
  @media (min-width: 75rem) {
    .header-inner { flex-wrap: nowrap; gap: 1.5rem; }
    nav, nav.enhanced, nav.enhanced.is-open { display: flex; flex: 1; justify-content: flex-end; align-items: center; gap: 1rem; width: auto; }
    .nav-links { gap: .8rem; }
    .menu-toggle:not([hidden]) { display: none; }
    .header-actions { flex-wrap: nowrap; }
  }
</style>
