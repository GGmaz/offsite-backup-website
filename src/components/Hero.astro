---
import Icon from './Icon.astro';
import { path } from '../config/site';
import type { Content } from '../content/types';
interface Props { content: Content }
const { hero: h } = Astro.props.content;
---
<section class="hero" aria-labelledby="hero-heading">
  <div class="hero-image" aria-hidden="true"><img src={path('images/security-hero.webp')} width="1536" height="1024" alt="" fetchpriority="high" /><span class="image-arc"></span></div>
  <div class="container hero-content">
    <div class="hero-copy">
      <p class="eyebrow">{h.eyebrow}</p>
      <h1 id="hero-heading"><strong>OFFSITE BACKUP</strong><span>{h.displayTitle}</span></h1>
      <p class="hero-description">{h.text}</p>
      <div class="hero-buttons"><a class="button" href="#pricing">{h.pricing}<Icon name="arrow" size={21} /></a><a class="how-link" href="#technical"><span class="play-circle"><Icon name="play" size={18} /></span><span>{h.how}</span></a></div>
    </div>
  </div>
  <svg class="bottom-wave" viewBox="0 0 600 130" preserveAspectRatio="none" aria-hidden="true"><path d="M0 15Q130 115 600 130H0Z" fill="#bedff4"/><path d="M0 48Q140 126 600 130H0Z" fill="#197ab9"/><path d="M0 70Q160 130 600 130H0Z" fill="#eaf5ff"/></svg>
</section>
<div class="trust-strip"><div class="container trust-items">{h.features.map((feature, i) => <div class="trust-item"><Icon name={['shield','server','cloud','clock','lock'][i]} size={38} /><p><strong>{feature.title}</strong><span>{feature.text}</span></p></div>)}</div></div>
<style>
  .hero { position: relative; background: linear-gradient(120deg,#fff 15%,#f3f8fc 100%); overflow: hidden; isolation: isolate; }
  .hero-content { position: relative; padding-block: 3.4rem 4.8rem; z-index: 2; }
  .hero-copy { max-width: 620px; }
  .eyebrow { color: var(--navy); letter-spacing: .25em; font-size: .7rem; margin-bottom: 1.15rem; font-weight: 550; }
  h1 { font-size: clamp(2.15rem,4.3vw,4.2rem); line-height: 1.07; letter-spacing: -.035em; font-weight: 800; margin: 0 0 1.3rem; }
  h1 strong { display: block; color: var(--navy); font-size: 1.08em; font-weight: 850; }
  h1 span { display: block; color: #3d6084; margin-top: .3rem; max-width: 610px; }
  .hero-description { color: #314a62; max-width: 500px; font-size: clamp(1rem,1.35vw,1.2rem); line-height: 1.6; margin-block: 0 1.8rem; }
  .hero-buttons { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.4rem; }
  .hero-buttons .button { min-height: 58px; padding: 1rem 1.6rem; text-transform: uppercase; letter-spacing: .025em; font-size: .76rem; box-shadow: 0 12px 25px #0065bf20; }
  .how-link { display: inline-flex; gap: .75rem; align-items: center; text-decoration: none; font-size: .78rem; font-weight: 500; max-width: 190px; line-height: 1.5; }
  .play-circle { display: grid; place-items: center; width: 46px; height: 46px; border: 1px solid #a3b6ca; border-radius: 50%; flex-shrink: 0; background: #ffffffb0; color: var(--navy); }
  .how-link:hover .play-circle { border-color: var(--blue); color: var(--blue); }
  .hero-image { position: relative; z-index: 0; height: 320px; }
  .hero-image img { width: 100%; height: 100%; object-fit: cover; object-position: 65% 65%; display: block; }
  .bottom-wave { position: absolute; left: 0; bottom: -1px; width: 45%; height: 80px; z-index: 1; pointer-events: none; }
  .trust-strip { background: linear-gradient(#fff,#f5f9fe); border-bottom: 1px solid var(--border); }
  .trust-items { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); padding-block: 1.4rem; gap: 1.1rem; }
  .trust-item { display: flex; align-items: center; gap: .8rem; min-width: 0; }
  .trust-item svg { color: #164c84; width: 30px; }
  .trust-item p { margin: 0; font-size: .74rem; line-height: 1.4; }
  .trust-item strong, .trust-item span { display: block; }
  .trust-item strong { font-weight: 750; text-transform: uppercase; font-size: .72rem; }
  .trust-item span { color: var(--muted); margin-top: .2rem; }
  @media (max-width: 63.99rem) { .hero { display: flex; flex-direction: column; } .hero-content { order: -1; padding-bottom: 2.3rem; } .bottom-wave { display: none; } }
  @media (min-width: 48rem) { .trust-items { grid-template-columns: repeat(5,minmax(0,1fr)); gap: 0; } .trust-item { padding-inline: 1rem; border-right: 1px solid #d1dfeb; } .trust-item:first-child { padding-left: 0; } .trust-item:last-child { border: 0; padding-right: 0; } }
  @media (min-width: 64rem) {
    .hero-content { min-height: 500px; display: flex; align-items: center; padding-block: 3.3rem 4rem; }
    .hero-copy { width: 48%; }
    .hero-image { position: absolute; right: 0; top: 0; bottom: 0; width: 58%; height: auto; border-radius: 44% 0 0 6% / 95% 0 0 8%; overflow: hidden; }
    .hero-image img { object-position: 62% 65%; }
    .image-arc { position: absolute; inset: 0; width: 100%; border-left: 12px solid #3276aa; border-radius: 44% 0 0 6% / 95% 0 0 8%; box-shadow: inset 14px 0 0 #bedcee; opacity: .72; pointer-events: none; }
    .trust-items { padding-block: 1.6rem; } .trust-item svg { width: 38px; }
  }
</style>
