---
import SiteLayout from '../layouts/SiteLayout.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import ServiceOverview from './ServiceOverview.astro';
import Benefits from './Benefits.astro';
import TechnicalSpecs from './TechnicalSpecs.astro';
import Pricing from './Pricing.astro';
import FAQ from './FAQ.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import type { Content } from '../content/types';
import type { Locale } from '../config/site';
interface Props { content: Content; locale: Locale }
const { content, locale } = Astro.props;
---
<SiteLayout content={content} locale={locale}><Header content={content} locale={locale} /><main id="main"><Hero content={content} /><ServiceOverview content={content} /><Benefits content={content} /><TechnicalSpecs content={content} /><Pricing content={content} /><FAQ content={content} /><Contact content={content} /></main><Footer content={content} locale={locale} /></SiteLayout>
