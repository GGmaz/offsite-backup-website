---
import Icon from './Icon.astro';
import { path } from '../config/site';
import type { Content } from '../content/types';
interface Props { content: Content }
const { content: c } = Astro.props;
const images = ['security-hero.webp','security-hero.webp','support-desk.webp'];
---
<div class="service-cards container">{c.hero.cards.map((card,i) => <a class:list={['service-card',`card-${i}`]} href={['#about','#technical','#contact'][i]} data-package={i === 2 ? 'consultation' : undefined}><img src={path(`images/${images[i]}`)} width="600" height="300" alt="" loading="lazy" /><span class="card-shade"></span><span class="card-content"><span class="card-title">{card}</span><span class="card-arrow"><Icon name="arrow" size={20} /></span></span>{i === 1 && <span class="cloud-mark" aria-hidden="true"><Icon name="cloud" size={96} /></span>}</a>)}</div>
<style>
  .service-cards { display: grid; gap: 1rem; margin-block: 1.5rem .75rem; }
  .service-card { position: relative; min-height: 180px; overflow: hidden; border-radius: 8px; color: white; text-decoration: none; background: #103d69; isolation: isolate; }
  img { width: 100%; height: 100%; position: absolute; inset: 0; object-fit: cover; object-position: 95% 25%; z-index: -2; }
  .card-shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg,#051d3aeb 0%,#05244494 55%,#071c361a 100%); }
  .card-content { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; padding: 1.7rem 1.8rem; max-width: 80%; }
  .card-title { font-size: 1.2rem; font-weight: 650; line-height: 1.4; text-wrap: balance; }
  .card-arrow { display: grid; place-items: center; width: 35px; height: 35px; border: 1px solid #b8d4ed; border-radius: 50%; transition: background-color .15s; }
  .service-card:hover .card-arrow { background: #ffffff25; }
  .card-1 img { object-position: 70% 10%; opacity: .35; }
  .cloud-mark { position: absolute; top: 22%; right: 10%; color: #d0eeff; filter: drop-shadow(0 0 16px #6edbff); z-index: -1; }
  .card-2 img { object-position: 65% 50%; }
  @media (min-width: 48rem) { .service-cards { grid-template-columns: repeat(3,minmax(0,1fr)); } .card-title { font-size: clamp(.98rem,1.4vw,1.35rem); } .card-content { padding: 1.6rem; } }
</style>
